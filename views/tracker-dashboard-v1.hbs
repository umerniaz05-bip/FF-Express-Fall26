<style>
  .gaming-dashboard {
    max-width: 1100px;
    margin: 30px auto;
    padding: 24px;
    background: #101525;
    color: #f1f3ff;
    border-radius: 12px;
    font-family: Arial, sans-serif;
  }

  .gaming-dashboard h1,
  .gaming-dashboard h2 {
    color: #b69cff;
  }

  .gaming-dashboard a {
    color: #b69cff;
  }

  .gaming-dashboard .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 24px 0;
  }

  .gaming-dashboard button {
    padding: 10px 16px;
    background: #ffb4b4;
    color: #101525;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }

  .gaming-dashboard .charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .gaming-dashboard .panel {
    min-width: 0;
    padding: 20px;
    background: #1b2033;
    border-radius: 10px;
  }

  .gaming-dashboard .chart-area {
    position: relative;
    height: 320px;
  }

  .gaming-dashboard .sketch-panel {
    margin-top: 20px;
  }

  #sessionSketch {
    width: 100%;
    overflow-x: auto;
  }

  #sessionSketch canvas {
    display: block;
  }

  @media (max-width: 700px) {
    .gaming-dashboard .charts {
      grid-template-columns: 1fr;
    }
  }
</style>

<main class="gaming-dashboard">
  <h1>Gaming Dashboard</h1>
  <p>Version 1 · Your latest 20 gaming sessions.</p>

  <div class="actions">
    <a href="/tracker/v1">← Add a session</a>

    <form action="/tracker/v1/clear" method="post">
      <button type="submit">Clear all data</button>
    </form>
  </div>

  {{#unless entries.length}}
    <p>No sessions yet. Add a gaming session to get started.</p>
  {{/unless}}

  <div class="charts">
    <section class="panel">
      <h2>Gaming Minutes by Date</h2>
      <div class="chart-area">
        <canvas id="dailyChart"></canvas>
      </div>
    </section>

    <section class="panel">
      <h2>Time by Game</h2>
      <div class="chart-area">
        <canvas id="gameChart"></canvas>
      </div>
    </section>
  </div>

  <section class="panel sketch-panel">
    <h2>Gaming Session Bubbles</h2>
    <p>Each bubble is one session. Larger bubbles mean more minutes.</p>
    <div id="sessionSketch"></div>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.8.0/p5.min.js"></script>

<script>
  const entries = {{{entriesJSON}}};

  const gameColors = {
    "Minecraft": "#4ade80",
    "Fortnite": "#60a5fa",
    "Elden Ring": "#b69cff",
    "Red Dead Redemption 2": "#fb923c",
    "Other": "#a1a1aa"
  };

  const dailyTotals = {};
  const gameTotals = {};

  for (let i = 0; i < entries.length; i++) {
    const entry = entries[i];

    if (dailyTotals[entry.date] === undefined) {
      dailyTotals[entry.date] = 0;
    }

    if (gameTotals[entry.game] === undefined) {
      gameTotals[entry.game] = 0;
    }

    dailyTotals[entry.date] += entry.minutes;
    gameTotals[entry.game] += entry.minutes;
  }

  const dates = Object.keys(dailyTotals).sort();
  const dailyMinutes = [];

  for (let i = 0; i < dates.length; i++) {
    dailyMinutes.push(dailyTotals[dates[i]]);
  }

  const games = Object.keys(gameTotals);
  const gameMinutes = [];
  const chartColors = [];

  for (let i = 0; i < games.length; i++) {
    gameMinutes.push(gameTotals[games[i]]);
    chartColors.push(gameColors[games[i]]);
  }

  Chart.defaults.color = "#f1f3ff";

  new Chart(document.getElementById("dailyChart"), {
    type: "bar",
    data: {
      labels: dates,
      datasets: [{
        label: "Minutes Played",
        data: dailyMinutes,
        backgroundColor: "#b69cff"
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        title: {
          display: true,
          text: "Gaming Minutes by Date"
        }
      },
      scales: {
        x: {
          title: {
            display: true,
            text: "Date"
          }
        },
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: "Total Minutes"
          }
        }
      }
    }
  });

  new Chart(document.getElementById("gameChart"), {
    type: "doughnut",
    data: {
      labels: games,
      datasets: [{
        label: "Minutes Played",
        data: gameMinutes,
        backgroundColor: chartColors,
        borderColor: "#1b2033"
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        title: {
          display: true,
          text: "Time by Game"
        },
        legend: {
          position: "bottom"
        }
      }
    }
  });

  // Draw one bubble per saved session, sized by minutes and colored by game.
  function setup() {
    const container = document.getElementById("sessionSketch");
    const canvasWidth = Math.max(160, Math.min(container.clientWidth, 1000));
    const columns = Math.max(1, Math.floor(canvasWidth / 160));
    const rows = Math.max(1, Math.ceil(entries.length / columns));
    const cellWidth = canvasWidth / columns;

    const canvas = createCanvas(canvasWidth, rows * 170);
    canvas.parent("sessionSketch");

    background("#1b2033");
    textAlign(CENTER, CENTER);
    textFont("Arial");
    noStroke();

    if (entries.length === 0) {
      fill("#f1f3ff");
      textSize(14);
      text("No sessions yet", width / 2, height / 2);
    }

    for (let i = 0; i < entries.length; i++) {
      const entry = entries[i];
      const x = (i % columns) * cellWidth + cellWidth / 2;
      const y = Math.floor(i / columns) * 170 + 85;
      const diameter = constrain(95 + entry.minutes / 8, 95, 145);

      fill(gameColors[entry.game]);
      circle(x, y, diameter);

      fill("#101525");
      textSize(11);

      const labelWidth = diameter * 0.8;

      text(
        entry.game + "\n" + entry.minutes + " min",
        x - labelWidth / 2,
        y - 36,
        labelWidth,
        72
      );
    }

    noLoop();
  }
</script>